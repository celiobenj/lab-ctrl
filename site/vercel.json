{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lab-ctrl-motor.vercel.app"
        }
      ],
      "destination": "https://lab-ctrl.vercel.app/motor-control/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lab-ctrl-identification.vercel.app"
        }
      ],
      "destination": "https://lab-ctrl.vercel.app/motor-identification/",
      "permanent": false
    }
  ]
}
